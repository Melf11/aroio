# Built in what the audio path needs at boot (no initramfs, no module loading wait)
CONFIG_SND_SOC=y
CONFIG_SND_BCM2835_SOC_I2S=y
CONFIG_SND_BCM2708_SOC_HIFIBERRY_DACPLUS=y
CONFIG_SND_USB_AUDIO=y
CONFIG_SND_ALOOP=y
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_ZSTD=y
CONFIG_EXT4_FS=y
# IR receiver via rc-core (replaces lircd), rotary encoder, GPIO keys and LEDs
CONFIG_RC_CORE=y
CONFIG_IR_GPIO_CIR=y
CONFIG_INPUT_GPIO_ROTARY_ENCODER=y
CONFIG_KEYBOARD_GPIO=y
CONFIG_LEDS_GPIO=y
# low latency (PREEMPT_RT is measured in phase 1 before it is enabled)
CONFIG_PREEMPT=y
CONFIG_HZ_1000=y
CONFIG_CPU_FREQ_DEFAULT_GOV_PERFORMANCE=y
CONFIG_ZRAM=y
# not needed on a headless audio device
# CONFIG_DRM_VC4 is not set
# CONFIG_VIDEO_DEV is not set
