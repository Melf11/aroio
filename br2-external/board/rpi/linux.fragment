# Root filesystem and data partition built in (no initramfs)
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_ZSTD=y
CONFIG_EXT4_FS=y
CONFIG_ZRAM=m
# Audio: ALSA loopback for CamillaDSP capture, USB audio (UMIK-1, USB DACs)
CONFIG_SND_ALOOP=m
CONFIG_SND_USB_AUDIO=m
# IR receiver via rc-core (replaces lircd), rotary encoder, GPIO keys and LEDs
CONFIG_RC_CORE=y
CONFIG_IR_GPIO_CIR=m
CONFIG_INPUT_GPIO_ROTARY_ENCODER=m
CONFIG_KEYBOARD_GPIO=m
CONFIG_LEDS_GPIO=y
# Low latency (PREEMPT_RT is measured in phase 1 before it is enabled)
CONFIG_PREEMPT=y
CONFIG_HZ_1000=y
CONFIG_CPU_FREQ_DEFAULT_GOV_PERFORMANCE=y
# iwd (WLAN, WPA2/WPA3): kernel crypto via AF_ALG and keyctl
CONFIG_KEYS=y
CONFIG_KEY_DH_OPERATIONS=y
CONFIG_CRYPTO_USER_API_HASH=y
CONFIG_CRYPTO_USER_API_SKCIPHER=y
CONFIG_CRYPTO_ECB=y
CONFIG_CRYPTO_CBC=y
CONFIG_CRYPTO_CMAC=y
CONFIG_CRYPTO_HMAC=y
CONFIG_CRYPTO_MD5=y
CONFIG_CRYPTO_SHA1=y
CONFIG_CRYPTO_SHA256=y
CONFIG_CRYPTO_SHA512=y
CONFIG_CRYPTO_AES=y
CONFIG_CRYPTO_DES=y
CONFIG_ASYMMETRIC_KEY_TYPE=y
CONFIG_ASYMMETRIC_PUBLIC_KEY_SUBTYPE=y
CONFIG_X509_CERTIFICATE_PARSER=y
CONFIG_PKCS7_MESSAGE_PARSER=y
CONFIG_PKCS8_PRIVATE_KEY_PARSER=y
# iwd uses /dev/rfkill to see whether the radio is blocked
CONFIG_RFKILL=y
