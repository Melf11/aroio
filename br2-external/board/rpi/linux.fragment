# Root filesystem and data partition built in (no initramfs)
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_ZSTD=y
CONFIG_EXT4_FS=y
CONFIG_ZRAM=m
# Audio: ALSA loopback for CamillaDSP capture, USB audio (UMIK-1, USB DACs)
CONFIG_SND_ALOOP=m
CONFIG_SND_USB_AUDIO=m
# IR receiver via rc-core (replaces lircd), rotary encoder, GPIO keys and LEDs
CONFIG_RC_CORE=y
CONFIG_IR_GPIO_CIR=m
CONFIG_INPUT_GPIO_ROTARY_ENCODER=m
CONFIG_KEYBOARD_GPIO=m
CONFIG_LEDS_GPIO=y
# Low latency (PREEMPT_RT is measured in phase 1 before it is enabled)
CONFIG_PREEMPT=y
CONFIG_HZ_1000=y
CONFIG_CPU_FREQ_DEFAULT_GOV_PERFORMANCE=y
# iwd (WLAN, WPA2/WPA3): kernel crypto via AF_ALG and keyctl
CONFIG_KEYS=y
CONFIG_KEY_DH_OPERATIONS=y
CONFIG_CRYPTO_USER_API_HASH=y
CONFIG_CRYPTO_USER_API_SKCIPHER=y
CONFIG_CRYPTO_ECB=y
CONFIG_CRYPTO_CBC=y
CONFIG_CRYPTO_CMAC=y
CONFIG_CRYPTO_HMAC=y
CONFIG_CRYPTO_MD5=y
CONFIG_CRYPTO_SHA1=y
CONFIG_CRYPTO_SHA256=y
CONFIG_CRYPTO_SHA512=y
CONFIG_CRYPTO_AES=y
CONFIG_CRYPTO_DES=y
CONFIG_ASYMMETRIC_KEY_TYPE=y
CONFIG_ASYMMETRIC_PUBLIC_KEY_SUBTYPE=y
CONFIG_X509_CERTIFICATE_PARSER=y
CONFIG_PKCS7_MESSAGE_PARSER=y
CONFIG_PKCS8_PRIVATE_KEY_PARSER=y
# iwd uses /dev/rfkill to see whether the radio is blocked
CONFIG_RFKILL=y
# modules uncompressed: the root file system is compressed anyway, kmod needs no xz, faster loading
# CONFIG_MODULE_COMPRESS is not set
# info screen on HDMI: large console font (built in, no setfont needed)
CONFIG_FONTS=y
CONFIG_FONT_TER16x32=y
CONFIG_FONT_8x16=y
# Slimmer kernel: subsystems an audio streamer does not use (video/DVB, CAN, IIO,
# RAID, joysticks, 1-wire, SATA, WLAN chips that are neither on board nor common
# USB sticks). rc-core (IR) does not depend on MEDIA_SUPPORT. Keymaps are not
# needed: aroiod maps the raw scancodes itself.
# CONFIG_MEDIA_SUPPORT is not set
# CONFIG_RC_MAP is not set
# CONFIG_CAN is not set
# CONFIG_IIO is not set
# CONFIG_MD is not set
# CONFIG_ATA is not set
# CONFIG_W1 is not set
# CONFIG_INPUT_JOYSTICK is not set
# CONFIG_INPUT_TABLET is not set
# CONFIG_HAMRADIO is not set
# CONFIG_NFC is not set
# CONFIG_WIMAX is not set
# CONFIG_IEEE802154 is not set
# CONFIG_WLAN_VENDOR_ADMTEK is not set
# CONFIG_WLAN_VENDOR_ATMEL is not set
# CONFIG_WLAN_VENDOR_INTEL is not set
# CONFIG_WLAN_VENDOR_INTERSIL is not set
# CONFIG_WLAN_VENDOR_MARVELL is not set
# CONFIG_WLAN_VENDOR_MICROCHIP is not set
# CONFIG_WLAN_VENDOR_PURELIFI is not set
# CONFIG_WLAN_VENDOR_RSI is not set
# CONFIG_WLAN_VENDOR_SILABS is not set
# CONFIG_WLAN_VENDOR_ST is not set
# CONFIG_WLAN_VENDOR_TI is not set
# CONFIG_WLAN_VENDOR_ZYDAS is not set
# CONFIG_WLAN_VENDOR_QUANTENNA is not set
