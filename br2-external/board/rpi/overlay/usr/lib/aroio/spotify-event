#!/usr/bin/python3
"""librespot --onevent hook -> aroiod (start/stop, title, cover, volume).
librespot passes everything in environment variables (PLAYER_EVENT, NAME, ...)."""
import json
import os
import urllib.request

e = os.environ
event = e.get("PLAYER_EVENT", "")
data = {"source": "spotify"}

if event in ("playing", "started"):
    data["event"] = "start"
elif event in ("paused", "stopped", "session_disconnected"):
    data["event"] = "stop"
elif event == "track_changed":
    covers = [c for c in e.get("COVERS", "").split("\n") if c]
    data["event"] = "meta"
    data["meta"] = {
        "id": "spotify:" + e.get("URI", e.get("TRACK_ID", "")),
        "title": e.get("NAME", ""), "artist": e.get("ARTISTS", "").replace("\n", ", "),
        "album": e.get("ALBUM", ""), "duration": round(int(e.get("DURATION_MS", "0") or 0) / 1000, 1),
        "image": covers[-1] if covers else None, "provider": "spotify", "live": False,
        "format": {"codec": "Vorbis", "bits": 16, "rate": 44100},
    }
elif event == "volume_changed":
    data["event"] = "volume"
    data["volume"] = round(int(e.get("VOLUME", "0") or 0) / 65535 * 100)
else:
    raise SystemExit(0)

req = urllib.request.Request("http://127.0.0.1/api/v1/internal/source", data=json.dumps(data).encode(),
                             headers={"Content-Type": "application/json"})
try:
    urllib.request.urlopen(req, timeout=2).read()
except OSError:
    pass
