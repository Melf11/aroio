#!/bin/sh
# Tells the neighbours (PCs, phones, switches) where the Aroio is: gratuitous ARP for every
# IPv4 address on the cable and the WLAN, a few times after the address is there.
# While the Aroio restarts, another device may answer for its address (seen in a company
# network); without this a PC keeps sending to that device until its ARP entry expires.
announce() {
    ip -4 -o addr show scope global | while read -r _ dev _ cidr _; do
        a=${cidr%/*}
        [ "$a" = 192.168.4.1 ] && continue          # setup hotspot
        arping -U -c 2 -w 3 -I "$dev" "$a" >/dev/null 2>&1
        arping -A -c 2 -w 3 -I "$dev" "$a" >/dev/null 2>&1
    done
}
i=0
while [ $i -lt 90 ] && [ -z "$(ip -4 -o addr show scope global)" ]; do sleep 1; i=$((i + 1)); done
for wait in 0 5 25; do
    sleep "$wait"
    announce
done
exit 0
