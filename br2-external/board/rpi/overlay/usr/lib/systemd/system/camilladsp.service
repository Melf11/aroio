[Unit]
Description=CamillaDSP audio engine
After=sound.target local-fs.target systemd-modules-load.service
Before=aroiod.service

[Service]
ExecStart=/usr/bin/camilladsp --wait -a 127.0.0.1 -p 1234
CPUSchedulingPolicy=fifo
CPUSchedulingPriority=80
LimitRTPRIO=95
LimitMEMLOCK=infinity
Restart=always
RestartSec=1

[Install]
WantedBy=multi-user.target
