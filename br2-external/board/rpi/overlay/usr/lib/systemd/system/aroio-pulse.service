[Unit]
Description=PulseAudio for Spotify (only into the loopback)
# started with aroio-soloist.service, stopped with it
StopWhenUnneeded=yes
After=sound.target

[Service]
ExecStart=/usr/bin/pulseaudio --system --daemonize=no --disallow-exit --disallow-module-loading \
    --exit-idle-time=-1 -n -F /etc/aroio/pulse.pa --log-target=journal
Restart=on-failure
RestartSec=2
