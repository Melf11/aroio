[Unit]
Description=Spotify Connect (librespot)
After=network-online.target avahi-daemon.service sound.target
Wants=network-online.target

[Service]
# AROIO_NAME: the device name, written by aroiod (same name for AirPlay, UPnP, Bluetooth)
Environment=AROIO_NAME=Aroio
EnvironmentFile=-/data/aroio/names.env
ExecStartPre=/bin/mkdir -p /data/spotify
# Volume stays with the Aroio (CamillaDSP): fixed volume in librespot, the Spotify
# app's volume reaches aroiod through the event hook.
ExecStart=/usr/bin/librespot --name ${AROIO_NAME} --device-type avr --backend alsa \
    --device plughw:Loopback,0,0 --format S32 --bitrate 320 --volume-ctrl fixed \
    --cache /data/spotify --disable-audio-cache --onevent /usr/lib/aroio/spotify-event \
    --emit-sink-events
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
