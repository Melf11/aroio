[Unit]
Description=Aroio control service and app
After=camilladsp.service data.mount network.target
Wants=camilladsp.service

[Service]
# Phase 0: root, because aroiod switches systemd units and reboots.
# Phase 1: own user + polkit rules for exactly these actions.
# aroio-python: image code, or developer code from /data/dev (./dev.sh deploy)
ExecStart=/usr/lib/aroio/aroio-python -m aroiod --data /data/aroio --port 80 --static /usr/share/aroio-web
Restart=always
RestartSec=1
ExecStartPost=-/usr/lib/aroio/mark-good

[Install]
WantedBy=multi-user.target
