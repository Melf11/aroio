[Unit]
Description=Aroio info screen on HDMI (only draws while a display is connected)
# early: the boot screen (logo, progress) until aroiod answers; not After=aroiod.service
After=local-fs.target
Conflicts=getty@tty1.service

[Service]
# aroiod/hdmi.py: Pillow into the KMS framebuffer; stdin is tty1 so it can switch the
# text console to graphics mode
ExecStart=/usr/lib/aroio/aroio-python -m aroiod.hdmi
StandardInput=tty
StandardOutput=journal
StandardError=journal
TTYPath=/dev/tty1
TTYReset=no
TTYVTDisallocate=no
Nice=10
Restart=always
RestartSec=5
# at shutdown it draws "Aroio startet neu …" itself and exits
TimeoutStopSec=5

[Install]
WantedBy=multi-user.target
