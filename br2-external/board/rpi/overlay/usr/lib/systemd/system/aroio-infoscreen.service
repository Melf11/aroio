[Unit]
Description=Aroio info screen on HDMI (tty1)
After=aroiod.service
Conflicts=getty@tty1.service

[Service]
ExecStart=/usr/lib/aroio/infoscreen
StandardInput=tty
StandardOutput=tty
TTYPath=/dev/tty1
TTYReset=yes
TTYVTDisallocate=yes
Environment=PYTHONDONTWRITEBYTECODE=1 PYTHONIOENCODING=utf-8 TERM=linux
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
