[Unit]
Description=Aroio info screen on HDMI (only draws while a display is connected)
# early, before /data and the rest: the boot screen (logo, progress) until aroiod answers
DefaultDependencies=no
After=systemd-udevd.service
Conflicts=getty@tty1.service shutdown.target
Before=shutdown.target

[Service]
# aroiod/hdmi.py: Pillow into the KMS framebuffer; stdin is tty1 so it can switch the
# text console to graphics mode
ExecStart=/usr/lib/aroio/aroio-python -m aroiod.hdmi
StandardInput=tty
StandardOutput=journal
StandardError=journal
TTYPath=/dev/tty1
TTYReset=no
TTYVTDisallocate=no
Nice=10
Restart=always
RestartSec=5
# at shutdown it draws "Aroio startet neu …" itself and exits
TimeoutStopSec=5

[Install]
# with DefaultDependencies=no it starts at once all the same
WantedBy=multi-user.target
