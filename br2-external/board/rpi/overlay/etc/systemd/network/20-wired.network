# Wired network: DHCP (IPv4 + IPv6). Static addresses from the app follow in phase 1
# (aroiod writes /run/systemd/network/ files that take precedence).
[Match]
Name=eth* en*

[Network]
DHCP=yes
IPv6AcceptRA=yes
LinkLocalAddressing=yes

[DHCPv4]
UseHostname=no
# identify by the MAC address: the machine-id (default DUID) is new on every boot of the
# read-only system, so the DHCP server would hand out a new address after each restart
ClientIdentifier=mac
